@@ -0,0 +1,4 @@
+-- Sole statement so the index builds outside an implicit transaction, without blocking chat writes.
+-- Replies that used tools: a steps block with at least one step (see the previous migration).
+CREATE INDEX CONCURRENTLY "messages_tool_work_idx" ON "messages" ("threadId", "seq")
+WHERE "role" = 'bot' AND jsonb_path_exists("blocks", '$[*] ? (@.kind == "steps" && @.steps.size() > 0)');
