+/**
+ * "Browse freely" (per bot): an always-allow rule of kind "browse" naming the bot lets its
+ * web_fetch reads open any site without a card. Sending, logins, payments and posting are other
+ * tools and keep their own approval.
+ */
+export function browsesFreely(rules: ActionApprovalRule[], botId: string | undefined): boolean {
+  if (!botId) return false;
+  const id = botId.toLowerCase();
+  return rules.some(
+    (rule) =>
+      rule.effect === "always_allow" &&
+      rule.matchKind === "browse" &&
+      rule.matchValue.toLowerCase() === id,
+  );
+}
