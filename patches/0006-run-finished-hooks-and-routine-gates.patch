+/**
+ * Sticks (patch 0006): gates asked before a routine occurrence runs. Any gate answering false skips this
+ * occurrence the same way a deactivated owner's routine is skipped (the schedule is kept). Used for a Stick's
+ * working hours and "off duty".
+ */
+export const routineGates: Array<(routine: { id: string; botId: string; spaceId: string }, scheduledAt: Date) => Promise<boolean> | boolean> = [];
+
+async function gatesAllow(routine: { id: string; botId: string; spaceId: string }, scheduledAt: Date): Promise<boolean> {
+  for (const gate of routineGates) if (!(await gate(routine, scheduledAt))) return false;
