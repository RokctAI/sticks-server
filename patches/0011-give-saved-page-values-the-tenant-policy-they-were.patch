Give saved page values the tenant policy they were missing

Upstream: elie222/rakazo#6929

diff --git a/packages/db/prisma/migrations/20270103130000_page_reader_states_tenant_policy/migration.sql b/packages/db/prisma/migrations/20270103130000_page_reader_states_tenant_policy/migration.sql
new file mode 100644
index 000000000..75f331868
--- /dev/null
+++ b/packages/db/prisma/migrations/20270103130000_page_reader_states_tenant_policy/migration.sql
@@ -0,0 +1,5 @@
+-- The reader's saved values belong to the Space the page is in, like every other protected table.
+-- The table shipped with only its system policy, so a tenant read returned nothing and a tenant
+-- write failed on the missing policy instead of being refused by the Space check.
+CREATE POLICY page_reader_states_tenant ON "page_reader_states"
+  USING ("spaceId" = NULLIF(current_setting('app.space_id', true), ''));
\ No newline at end of file
diff --git a/packages/db/src/pages/page-reader-state-policy.postgres.test.ts b/packages/db/src/pages/page-reader-state-policy.postgres.test.ts
new file mode 100644
index 000000000..fffaf9dc0
--- /dev/null
+++ b/packages/db/src/pages/page-reader-state-policy.postgres.test.ts
@@ -0,0 +1,35 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { createDb } from "../database/client.js";
+
+// Needs the owner URL, as `pnpm test:integration` provides after `pnpm db:migrate`.
+const runtimeUrl = process.env.DATABASE_URL;
+const migrationUrl = process.env.DATABASE_MIGRATION_URL;
+const describePostgres =
+  process.env.VERIFY_DATABASE && runtimeUrl && migrationUrl && runtimeUrl !== migrationUrl
+    ? describe
+    : describe.skip;
+
+describePostgres("page reader state policies", () => {
+  let owner: ReturnType<typeof createDb>;
+
+  beforeAll(() => {
+    owner = createDb(migrationUrl as string);
+  });
+
+  afterAll(async () => {
+    await owner.prisma.$disconnect();
+    await owner.pool.end();
+  });
+
+  it("scopes a saved page value to the reader's Space", async () => {
+    const policies = await owner.prisma.$queryRaw<Array<{ policyname: string; qual: string }>>`
+      SELECT policyname, qual::text AS qual
+      FROM pg_policies
+      WHERE tablename = 'page_reader_states'`;
+    const tenant = policies.find((policy) => policy.policyname === "page_reader_states_tenant");
+    expect(tenant, "page_reader_states has no tenant policy").toBeDefined();
+    // The predicate itself, not just the column name, so a policy that stopped comparing the
+    // configured Space fails here instead of passing on a mention of the column.
+    expect(tenant?.qual).toMatch(/"spaceId"\s*=\s*NULLIF\(current_setting\('app\.space_id'/);
+  });
+});
