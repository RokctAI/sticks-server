+// Sticks (sticks-server patch 0010): a Stick does not read Spam or Junk. Those folders are where
+// hostile mail lands, so a mail tool call that asks for them is refused unless the owner's own
+// words in this run name spam or junk, and messages a mail tool returns that carry a spam or junk
+// label are replaced by a stub (id and a note) before the model sees them.
+
+const MAIL_TOOL = /mail|gmail|outlook|inbox|imap|message/i;
+const SPAM_WORD = /\b(spam|junk|bulk mail|junk e-?mail)\b/i;
+const SPAM_ARG = /(^|[\s:"'(\/_-])(spam|junk|junkemail|bulk)([\s"')\/_-]|$)/i;
+const SPAM_LABEL = /^(spam|junk|junkemail|junk e-?mail|bulk)$/i;
+
+export function isMailTool(toolName: string): boolean {
+  return MAIL_TOOL.test(toolName);
+}
+
+/** The owner asked about spam or junk in their own words. */
+export function ownerAskedForSpam(ownerWords: string): boolean {
+  return SPAM_WORD.test(ownerWords);
+}
+
+/** A mail call whose arguments point at Spam or Junk (a query like in:spam, a label or folder). */
+export function mailCallTargetsSpam(toolName: string, args: unknown): boolean {
+  if (!isMailTool(toolName)) return false;
+  let found = false;
+  const walk = (v: unknown, depth: number) => {
+    if (found || depth > 8) return;
+    if (typeof v === "string") {
+      if (SPAM_ARG.test(v)) found = true;
+      return;
+    }
+    if (v && typeof v === "object")
+      for (const x of Array.isArray(v) ? v : Object.values(v as Record<string, unknown>)) walk(x, depth + 1);
+  };
+  walk(args, 0);
+  return found;
+}
+
+function labelled(v: Record<string, unknown>): boolean {
+  for (const key of ["labelIds", "labels", "label_ids", "categories"]) {
+    const labels = v[key];
+    if (Array.isArray(labels) && labels.some((l) => typeof l === "string" && SPAM_LABEL.test(l.trim())))
+      return true;
+  }
+  for (const key of ["folder", "folderName", "mailbox", "parentFolderId", "label"]) {
+    const f = v[key];
+    if (typeof f === "string" && SPAM_LABEL.test(f.trim())) return true;
+  }
+  return false;
+}
+
+/** Drop spam/junk-labelled messages from a mail tool's result. Returns the same value when none. */
+export function dropSpamMessages<T>(value: T): { value: T; dropped: number } {
+  let dropped = 0;
+  const walk = (v: unknown, depth: number): unknown => {
+    if (depth > 12 || v === null || typeof v !== "object") return v;
+    if (Array.isArray(v)) {
+      let changed = false;
+      const out: unknown[] = [];
+      for (const x of v) {
+        if (x && typeof x === "object" && !Array.isArray(x) && labelled(x as Record<string, unknown>)) {
+          // Kept as a stub, so the Stick can tell the owner the email is in Spam and ask.
+          const m = x as Record<string, unknown>;
+          dropped++;
+          changed = true;
+          out.push({
+            ...(m.id !== undefined ? { id: m.id } : {}),
+            in_spam: true,
+            note: "This email is in Spam or Junk and was not read. Tell the owner; read it only if they say so.",
+          });
+          continue;
+        }
+        const y = walk(x, depth + 1);
+        if (y !== x) changed = true;
+        out.push(y);
+      }
+      return changed ? out : v;
+    }
+    if (Object.getPrototypeOf(v) !== Object.prototype) return v;
+    let changed = false;
+    const out: Record<string, unknown> = {};
+    for (const [k, x] of Object.entries(v as Record<string, unknown>)) {
+      const y = walk(x, depth + 1);
+      if (y !== x) changed = true;
+      out[k] = y;
+    }
+    return changed ? out : v;
+  };
+  const cleaned = walk(value, 0) as T;
+  return { value: cleaned, dropped };
+}
+
+/**
+ * Ray 2026-11-28: attachments of these kinds are not opened (HTML pages, archives, programs,
+ * scripts, disk images, macro documents). The Stick names the file to the owner instead.
+ */
+export const BLOCKED_ATTACHMENT =
+  /\.(html?|xhtml|shtml|mht(ml)?|svg|zip|rar|7z|tar|gz|tgz|bz2|xz|cab|iso|img|vhdx?|exe|msi|com|scr|bat|cmd|ps1|vbs|vbe|js|jse|wsf|hta|jar|lnk|apk|docm|xlsm|pptm|one)$/i;
+
+const NAME_KEYS = ["filename", "fileName", "file_name", "name", "attachment_name", "title"];
+
+function namesIn(v: unknown, depth = 0, out: string[] = []): string[] {
+  if (depth > 6 || v === null || typeof v !== "object") return out;
+  for (const [k, x] of Object.entries(v as Record<string, unknown>)) {
+    if (typeof x === "string" && NAME_KEYS.includes(k)) out.push(x);
+    else namesIn(x, depth + 1, out);
+  }
+  return out;
+}
+
+/** A mail call that downloads an attachment whose file name is a blocked kind. */
+export function blockedAttachmentCall(toolName: string, args: unknown): string | undefined {
+  if (!isMailTool(toolName) || !/attach|download|file/i.test(`${toolName} ${JSON.stringify(args ?? {})}`)) return undefined;
+  return namesIn(args).find((n) => BLOCKED_ATTACHMENT.test(n.trim()));
+}
+
+const CONTENT_KEYS = ["data", "content", "body", "base64", "bytes", "text", "contentBytes"];
+
+/** Replace the contents of blocked-kind attachments in a mail result with a note. */
+export function blockAttachments<T>(value: T): { value: T; blocked: number } {
+  let blocked = 0;
+  const walk = (v: unknown, depth: number): unknown => {
+    if (depth > 12 || v === null || typeof v !== "object") return v;
+    if (Array.isArray(v)) {
+      let changed = false;
+      const out = v.map((x) => {
+        const y = walk(x, depth + 1);
+        if (y !== x) changed = true;
+        return y;
+      });
+      return changed ? out : v;
+    }
+    if (Object.getPrototypeOf(v) !== Object.prototype) return v;
+    const obj = v as Record<string, unknown>;
+    const name = NAME_KEYS.map((k) => obj[k]).find((x): x is string => typeof x === "string");
+    if (name && BLOCKED_ATTACHMENT.test(name.trim()) && CONTENT_KEYS.some((k) => k in obj)) {
+      blocked++;
+      const kept: Record<string, unknown> = {};
+      for (const [k, x] of Object.entries(obj)) if (!CONTENT_KEYS.includes(k)) kept[k] = x;
+      return { ...kept, blocked: `Attachment "${name}" is a kind that is never opened (web page, archive or program). Tell the owner its name; do not open it.` };
+    }
+    let changed = false;
+    const out: Record<string, unknown> = {};
+    for (const [k, x] of Object.entries(obj)) {
+      const y = walk(x, depth + 1);
+      if (y !== x) changed = true;
+      out[k] = y;
+    }
+    return changed ? out : v;
+  };
+  return { value: walk(value, 0) as T, blocked };
+}
