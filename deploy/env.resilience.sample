# Resilience and cost caps for a tenant. Env only, no upstream patch, so the weekly sync is not affected.
# Names checked against upstream v0.8.0 .env.example. Values are PROPOSALS, not yet tested on a live
# instance; Ray agrees them one by one before they go in the "Sticks Server Settings" DocType.
# Secrets (OPENROUTER_API_KEY etc.) come from occultation, never from here.

# --- Provider limit (429) / model fallback ---
# Upstream has no ordered fallback chain for a Stick's main model, and a 429 is not retried for media.
# Route the deployment default through one router key so one provider's limit does not fail the run.
PI_DEFAULT_PROVIDER=openrouter
# PI_DEFAULT_MODEL=<router model id agreed with Ray>
# Retry a failed model stream (integer 0-5, upstream default 1). Covers transient provider failures.
MODEL_STREAM_MAX_RETRIES=3
# Wait for first response / next chunk (ms). Upstream defaults shown; lower only after testing.
# MODEL_STREAM_TIMEOUT_MS=120000
# MODEL_STREAM_IDLE_TIMEOUT_MS=180000

# --- Stuck work / run caps ---
# Soft-stop a turn after this many tool calls and still send a final message. Unset = unlimited.
MAX_TOOL_CALLS_PER_TURN=60
# Idle computers sleep after this many ms (upstream default 600000). Must stay above 0 for the caps below.
SANDBOX_IDLE_MS=600000
# Hard uptime cap for a Stick's computer, on Docker/Kubernetes/Incus (upstream default 0 = off).
COMPUTER_MAX_ACTIVE_UNBILLED_MS=3600000
# Same for providers that bill while running (upstream default 7200000).
COMPUTER_MAX_ACTIVE_MS=3600000
# Bot-to-bot chain length before the next message is refused (upstream default 6).
BOT_MESSAGE_MAX_HOPS=6
