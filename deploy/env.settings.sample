# Settings we choose for a tenant (rendered from the Frappe "Sticks Server Settings" DocType later).
# Intentionally empty: settings are agreed one by one with the owner, then fixed in the DocType.
# Secrets never go here (occultation holds them). Image tags come from ../upstream.pin via
# scripts/render_env.py, not from this file.
#
# Candidates (see rakazo-backend-notes.md, notes 2 and 12): SIGNUPS_ENABLED, TICKET_BOARD_ENABLED,
# SANDBOX_TEAM_SCREEN_LIMIT, SANDBOX_MAX_COMPUTERS_PER_SPACE, RAKAZO_COMPUTER_MEMORY,
# GRAPHILE_WORKER_CONCURRENCY, MAX_UPLOAD_SIZE_MB, OIDC_* (sign-in through Frappe), EMAIL_*.

# Settings already agreed (on for every tenant). Read by both the API and the worker.
# Ticket board: gives Sticks the board_tickets / ticket_* tools and the app's Team board.
TICKET_BOARD_ENABLED=true
